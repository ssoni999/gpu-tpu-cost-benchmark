# Copy to tpu.env and fill in before running on TPU VM (do not commit tpu.env).
export PROJECT_ID=impactful-hawk-500418-e0
# v6e (Trillium) is not available in us-central1 — use a region that carries it (e.g. us-east5, us-east1, europe-west4).
export ZONE=us-east5-a
export TPU_NAME="${USER}-v6e-qwen3-4b"
export QR_ID="${USER}-v6e-qr"

# v6e single-chip (Qwen3-4B)
export TPU_ACCELERATOR_TYPE=v6e-1
export TPU_RUNTIME_VERSION=v2-alpha-tpuv6e

# On-demand $/hour — replace with current Cloud TPU v6e pricing.
export TPU_ACCELERATOR_HOURLY_USD=2.70
export TPU_VM_HOURLY_USD=0.0

export HF_TOKEN=your-huggingface-token
