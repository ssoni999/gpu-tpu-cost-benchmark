# Copy to gpu.env and fill in before running on GCE (do not commit gpu.env).
export PROJECT_ID=impactful-hawk-500418-e0
export ZONE=us-central1-a
export VM_NAME="${USER}-a3-qwen3-4b"

# GKE cluster that owns the on-demand GPU node pool (see benchmark_config.yaml gpu.node_pool.name).
# Used by scripts/gpu_ondemand.py to scale the pool up for advisor "Run on GPU" requests.
export CLUSTER_NAME=my-cluster

# On-demand $/hour — replace with your actual A3 (H100) rate.
export GPU_ACCELERATOR_HOURLY_USD=10.60
export GPU_VM_HOURLY_USD=0.46

export HF_TOKEN=your-huggingface-token
